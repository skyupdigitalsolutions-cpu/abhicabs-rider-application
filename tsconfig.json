{
  "extends": "expo/tsconfig.base.json",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ]
    }
  },
  "include": [
   "**/*.ts", "**/*.tsx", "nativewind-env.d.ts", "svg.d.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}